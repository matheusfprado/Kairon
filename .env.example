KAIRON_HOST=127.0.0.1
KAIRON_PORT=8765
KAIRON_DB_PATH=data/kairon.db
KAIRON_LLM_PROVIDER=ollama
KAIRON_OLLAMA_BASE_URL=http://127.0.0.1:11434
KAIRON_OLLAMA_MODEL=qwen3:8b
KAIRON_OLLAMA_TIMEOUT_SECONDS=120
# Modelos ja instalados, em ordem de tentativa, separados por virgula.
KAIRON_OLLAMA_FALLBACK_MODELS=llama3.2:3b
KAIRON_LLM_FAILURE_COOLDOWN_SECONDS=30
KAIRON_CONVERSATION_TIMEOUT_SECONDS=8
KAIRON_MICROPHONE_ECHO_GUARD_SECONDS=1.2
KAIRON_STT_MODEL=base
KAIRON_STT_LANGUAGE=pt
KAIRON_STT_BEAM_SIZE=1
KAIRON_MICROPHONE_DEVICE=20
KAIRON_MICROPHONE_VAD_MODE=0
KAIRON_MICROPHONE_SPEECH_FRAMES=3
KAIRON_MICROPHONE_SILENCE_SECONDS=0.45
KAIRON_MICROPHONE_MIN_RMS=0
KAIRON_AUDIO_OUTPUT_DEVICE=4
KAIRON_WAKE_WORD_MODEL=models/wake-word/kairon.ppn
KAIRON_WAKE_WORD_ALIASES=kairon,cairon,kiron,kairom,caíron,kyron
KAIRON_WAKE_WORD_REQUIRED=true
KAIRON_WEB_SEARCH_MAX_RESULTS=5
KAIRON_KNOWLEDGE_PATH=knowledge
KAIRON_KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text-v2-moe
KAIRON_KNOWLEDGE_EMBEDDING_DIMENSIONS=256
KAIRON_KNOWLEDGE_SEARCH_LIMIT=4
KAIRON_KNOWLEDGE_MIN_SCORE=0.33
KAIRON_KNOWLEDGE_MAX_FILE_MB=25
KAIRON_TTS_PROVIDER=edge
# Voz neural em portugues; o Windows fica como fallback offline.
KAIRON_TTS_VOICE=pt-BR-AntonioNeural
KAIRON_TTS_RATE=-3%
KAIRON_TTS_PITCH=+0Hz
